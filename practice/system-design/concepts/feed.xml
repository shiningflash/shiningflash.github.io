---
layout: compress
permalink: /practice/system-design/concepts/feed.xml
sitemap: false
---

{% capture source %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ "/practice/system-design/concepts/" | absolute_url }}</id>
  <title>{{ site.title }} — System Design Concepts</title>
  <subtitle>Short, plain-English answers to the most common system design questions. Caching, queueing, consistency, load balancers, cloud trade-offs.</subtitle>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.social.name }}</name>
    <uri>{{ "/" | absolute_url }}</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}"/>
  <link rel="alternate" type="text/html" hreflang="{{ site.alt_lang | default: site.lang }}" href="{{ '/practice/system-design/concepts/' | absolute_url }}"/>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <rights> © {{ 'now' | date: '%Y' }} {{ site.social.name }} </rights>

  {%- assign live = site.sd_concepts | where: "status", "live" | sort: "last_modified_at" | reverse -%}
  {% for c in live limit: 20 %}
    {% assign c_url = c.url | absolute_url %}
    <entry>
      <title>{{ c.title }}</title>
      <link href="{{ c_url }}" rel="alternate" type="text/html" title="{{ c.title | xml_escape }}" />
      {%- if c.last_modified_at -%}
        <published>{{ c.last_modified_at | date_to_xmlschema }}</published>
        <updated>{{ c.last_modified_at | date_to_xmlschema }}</updated>
      {%- else -%}
        <published>{{ site.time | date_to_xmlschema }}</published>
        <updated>{{ site.time | date_to_xmlschema }}</updated>
      {%- endif %}
      <id>{{ c_url }}</id>
      <author>
        <name>{{ site.social.name }}</name>
      </author>
      <category term="{{ c.section }}" />
      {%- if c.tease %}
      <summary>{{ c.tease | strip | xml_escape }}</summary>
      {%- endif %}
    </entry>
  {% endfor %}
</feed>
{% endcapture %}
{{ source | replace: '&', '&amp;' }}
